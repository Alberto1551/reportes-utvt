# Copia este archivo como .env y pon los datos de tu proyecto de Supabase
# (Supabase > Project Settings > API). La anon/publishable key es pública por diseño:
# la seguridad real está en las políticas RLS de supabase/schema.sql.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
